<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.garganttua</groupId>
		<artifactId>garganttua-api-dao</artifactId>
		<version>3.0.0-ALPHA21</version>
	</parent>
	<artifactId>garganttua-api-dao-postgresql</artifactId>
	<description>PostgreSQL DAO implementation — relational mapping, one column per field, backed by JDBC.</description>

	<dependencies>
		<!-- Garganttua API -->
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-commons</artifactId>
		</dependency>

		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-binding-postgresql</artifactId>
		</dependency>

		<!-- JSONB columns (untyped / recursive shapes, IKey descriptors) and GeoJSON for PostGIS
		     are (de)serialised through Jackson; the binding wrapper pins jackson-databind and
		     geojson-jackson. -->
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-binding-jackson</artifactId>
		</dependency>

		<!-- IKey persistence bridge: serialise/reconstruct crypto key material at the
		     DAO boundary (KeySerializer + KeyAlgorithm live here; IKey + enums are in
		     garganttua-commons, already on the classpath). -->
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-crypto</artifactId>
		</dependency>

		<!-- AOT support. The @Reflected annotation processor emits AOTClass_*
		     descriptors into target/generated-sources/annotations referencing
		     com.garganttua.core.aot.reflection, so that artefact is needed on the
		     compile + runtime classpath. aot-commons carries the
		     IAOTInfrastructureSeed SPI implemented by PostgresDaoInfrastructureSeed. -->
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-aot-reflection</artifactId>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-aot-commons</artifactId>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- A reflection stack for IClass.getClass(...) in tests (ServiceLoader cold-start via Bootstrap.builder()). -->
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-bootstrap</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-runtime-reflection</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-reflections</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Parity tests run the SAME operations on the MongoDB DAO against a real mongod, and demand
		     the same answers: "iso-functional with MongoDB" is checked, not asserted. -->
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-dao-mongodb</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- A REAL PostgreSQL 17 for the tests, from Maven-fetched binaries (every platform, pinned
		     by the BOM in the api parent): no Docker needed. -->
		<dependency>
			<groupId>io.zonky.test</groupId>
			<artifactId>embedded-postgres</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<!-- The shared config/checkstyle/checkstyle.xml references the suppressions filter
		     property ${checkstyle.suppressions.file}, but the parent quality profile never
		     binds the plugin's suppressionsLocation, so the expression is unset and the
		     check goal aborts. Bind it here (module-local) to the existing, unmodified
		     shared suppressions file so checkstyle:check resolves the property. -->
		<profile>
			<id>quality</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-checkstyle-plugin</artifactId>
						<configuration>
							<suppressionsLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/suppressions.xml</suppressionsLocation>
							<suppressionsFileExpression>checkstyle.suppressions.file</suppressionsFileExpression>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
